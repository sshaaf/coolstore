apiVersion: v1
kind: Secret
metadata:
  name: coolstore-secrets
  labels:
    app: coolstore-quarkus
    app.kubernetes.io/name: coolstore-quarkus
    app.kubernetes.io/component: backend
    app.kubernetes.io/part-of: coolstore
type: Opaque
stringData:
  # Database secrets (if using external database)
  # QUARKUS_DATASOURCE_PASSWORD: "changeme"

  # API keys and tokens
  # API_KEY: "your-api-key-here"
  # AUTH_TOKEN: "your-auth-token-here"

  # External service credentials
  # EXTERNAL_SERVICE_USERNAME: "username"
  # EXTERNAL_SERVICE_PASSWORD: "password"

  # Encryption keys
  # ENCRYPTION_KEY: "your-encryption-key-here"

  # Additional secrets
  # Add your application-specific secrets here

---
